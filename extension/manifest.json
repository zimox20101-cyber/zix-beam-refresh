{
  "manifest_version": 3,
  "name": "Zix Beam Tools",
  "version": "1.0.0",
  "description": "Zix Beam Tools - Spiderman themed session refresher",
  "permissions": ["storage"],
  "host_permissions": ["https://rblxrefresh.net/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
